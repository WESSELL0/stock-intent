# Names only. Keep actual secrets in user-level credentials or hosting secrets.
# Never prefix a secret with NEXT_PUBLIC_. CLI probes also read the standard
# user-level hithink-finance/credentials.env file without copying it here.
HITHINK_FINANCE_API_KEY=
# Optional override of a user-level credential FILE path; never a key value.
HITHINK_CREDENTIALS_FILE=
# Optional server-side LLM parser for expressions outside the verified preset.
LLM_API_KEY=
LLM_MODEL=
LLM_BASE_URL=
SNAPSHOT_PATH=data/snapshots/current.json
