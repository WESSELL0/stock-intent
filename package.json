{
  "name": "stock-intent",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build --webpack",
    "start": "next start",
    "lint": "eslint . --max-warnings=0",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "verify:data": "node --import tsx scripts/verify-finance.ts",
    "snapshot:plan": "node --import tsx scripts/build-market-snapshot.ts --plan",
    "snapshot:build": "node --import tsx scripts/build-market-snapshot.ts --execute",
    "release:check": "node --import tsx scripts/check-release.ts",
    "test:e2e": "node --import tsx scripts/verify-browser.ts"
  },
  "dependencies": {
    "next": "16.3.6",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/node": "24.19.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.6",
    "tsx": "4.23.15",
    "typescript": "5.9.3"
  }
}
